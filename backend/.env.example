# Matches docker-compose.yml defaults. Override for custom local setups.
DATABASE_URL=postgresql://user_name:your_password@localhost:5432/mldock

# Other defaults (safe to leave as-is for local development)
# Leave empty to auto-generate a random key (saved to STORAGE_PATH/.secret_key),
# or set a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
STORAGE_PATH=./storage